# ExamRadar India - Environment Configuration
# Copy this file to .env and fill in actual values

# Database
DATABASE_URL=sqlite:///./examradar.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/examradar

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_SECRET_KEY=change-this-to-a-random-secret-key-in-production
CORS_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000

# Discovery
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MINUTES=60
DISCOVERY_MAX_CONCURRENT=3
DISCOVERY_REQUEST_TIMEOUT=30
DISCOVERY_RESPECT_ROBOTS_TXT=true

# Optional: Gemini AI API (for enhanced text extraction)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: Web Search API (for search-based discovery)
SEARCH_API_KEY=
SEARCH_PROVIDER=google
SEARCH_DAILY_LIMIT=100

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=examradar.log
